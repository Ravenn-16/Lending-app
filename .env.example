APP_NAME="Lending System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lending_system
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BCRYPT_ROUNDS=12

# Email login verification (enable after configuring working SMTP)
# Production defaults to enabled if LOGIN_CODE_ENABLED is omitted.
# OWNER_USERNAME must match the owner's existing administrator username.
OWNER_USERNAME=
OWNER_EMAIL=
# LOGIN_CODE_ENABLED=true
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=your-smtp-host
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="Lending System"

# Render Free + Aiven deployment (set privately in Render, not in Git):
# SESSION_DRIVER=database
# CACHE_STORE=database
# MYSQL_ATTR_SSL_CA=/var/www/html/storage/app/private/aiven-ca.pem
# AIVEN_CA_CERT=<full PEM certificate with real newlines>
# MAIL_MAILER=resend
# RESEND_KEY=
# OWNER_PASSWORD_HASH=<output of php artisan admin:password-hash>
